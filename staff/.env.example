# Copy this file to ".env" in the same folder. Then fill in the values.
# NEVER commit ".env": the repo is public.

# Twilio keys. With empty values the app sends no SMS and shows a banner.
# With keys, each send is a real, paid SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Folder of the Excel file. Empty = Documents/ЕГЕР-Сервиз.
# For development: EGER_DATA_DIR=./data
EGER_DATA_DIR=

# Port of the local server. Empty = 3000.
PORT=
