# Development: copy this file to ".env" in the same folder.
# Staff PC: copy it to Documents\ЕГЕР-Сервиз\настройки.env (the built app
# reads that file first). Then fill in the values.
# NEVER commit ".env" or "настройки.env": the repo is public.

# Twilio keys. With empty values the app sends no SMS and shows a banner.
# With keys, each send is a real, paid SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Folder of the Excel file. Empty = Documents/ЕГЕР-Сервиз.
# For development: EGER_DATA_DIR=./data
# (Set here, the app does not look for настройки.env in that folder.)
EGER_DATA_DIR=

# First port to try. Empty = 3000. A busy port: the next one, up to 3010.
PORT=
